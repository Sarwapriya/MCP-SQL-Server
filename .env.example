TRANSPORT=streamable-http
HOST=127.0.0.1
PORT=8000
MSSQL_SERVER=your-server.database.windows.net
MSSQL_DATABASE=your-database
MSSQL_USERNAME=your-username
MSSQL_PASSWORD=your-password
MSSQL_PORT=1433
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Azure SQL Database always requires encrypted connections — leaving this
# false causes a silent "Login timeout expired" hang, not a clean rejection.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=true

# Optional second connection, selected via the `connection="secondary"` tool argument.
# Leave MSSQL2_SERVER unset/blank to disable it entirely.
MSSQL2_SERVER=
MSSQL2_DATABASE=
MSSQL2_USERNAME=
MSSQL2_PASSWORD=
MSSQL2_PORT=1433
MSSQL2_DRIVER=ODBC Driver 17 for SQL Server
MSSQL2_ENCRYPT=true
MSSQL2_TRUST_SERVER_CERT=true

POOL_SIZE=10
POOL_MAX_OVERFLOW=20
POOL_TIMEOUT=30
POOL_RECYCLE=3600

MAX_ROWS=10000
QUERY_TIMEOUT=120
ALLOW_WRITE_OPERATIONS=false

REDIS_URL=redis://redis:6379
REDIS_ENABLED=false
SCHEMA_CACHE_TTL=3600

LOG_LEVEL=INFO
